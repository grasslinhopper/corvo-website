{% doc %}
  @prompt
    Create a product information specifications section below the product details with the following:
    Section Header:
    
    Title: 'Informação do Produto' (or 'Product Information')
    Thin horizontal line divider below the title
    Dark text on light gray/off-white background
    
    Specifications Table:
    
    Two-column layout with labels on the left and values on the right
    Left column: bold/medium weight labels, left-aligned
    Right column: regular weight values, right-aligned, gray text
    Thin divider lines between each row
    
    Specification Rows (label | value):
    
    'Tipo de Produto' | 'Hand-Tufted'
    'Técnica' | 'Pelo Cortado'
    'Altura do Pêlo' | '14-25mm'
    'Materiais' | 'Bamboo, Botanical Silk'
    'Dimensões' | '2X3m'
    'Utilização' | 'Hotelaria, Residencial'
    'Gama de Preços' | '4'
    'Tamanhos Recomendados' | '2X3m'
    'Cores' | 'Mix'
    
    Footer Notes:
    
    Small text in muted color below the table
    Line 1: '*Outras cores, formas e tamanhos a pedido'
    Line 2: Longer disclaimer text about color accuracy (in Portuguese)
    
    Style Guidelines:
    
    Clean, minimal design with generous spacing
    Professional typography
    Mobile responsive: may need to adjust alignment on smaller screens
    Consistent padding throughout
    Match the overall page aesthetic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-specs-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-product-specs__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-specs__header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-product-specs__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.divider_spacing }}px 0;
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: 0.05em;
  }

  .ai-product-specs__divider-{{ ai_gen_id }} {
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    border: none;
    margin: 0;
  }

  .ai-product-specs__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    margin-top: {{ block.settings.table_spacing }}px;
  }

  .ai-product-specs__row-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.row_divider_color }};
  }

  .ai-product-specs__row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-product-specs__label-{{ ai_gen_id }},
  .ai-product-specs__value-{{ ai_gen_id }} {
    padding: {{ block.settings.row_padding }}px 0;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  .ai-product-specs__label-{{ ai_gen_id }} {
    font-weight: {{ block.settings.label_weight }};
    color: {{ block.settings.label_color }};
    text-align: left;
    width: {{ block.settings.label_width }}%;
    padding-right: 20px;
  }

  .ai-product-specs__value-{{ ai_gen_id }} {
    font-weight: 400;
    color: {{ block.settings.value_color }};
    text-align: right;
  }

  .ai-product-specs__footer-{{ ai_gen_id }} {
    margin-top: {{ block.settings.footer_spacing }}px;
  }

  .ai-product-specs__note-{{ ai_gen_id }} {
    font-size: {{ block.settings.note_size }}px;
    color: {{ block.settings.note_color }};
    line-height: 1.5;
    margin: 8px 0 0 0;
  }

  @media screen and (max-width: 749px) {
    .ai-product-specs__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-product-specs__label-{{ ai_gen_id }},
    .ai-product-specs__value-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.9);
      padding: {{ block.settings.row_padding | times: 0.8 }}px 0;
    }

    .ai-product-specs__label-{{ ai_gen_id }} {
      width: 50%;
      padding-right: 12px;
    }

    .ai-product-specs__note-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.note_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-product-specs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-specs__container-{{ ai_gen_id }}">
    <div class="ai-product-specs__header-{{ ai_gen_id }}">
      <h2 class="ai-product-specs__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      <hr class="ai-product-specs__divider-{{ ai_gen_id }}">
    </div>

    <table class="ai-product-specs__table-{{ ai_gen_id }}">
      {% if block.settings.show_spec_1 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_1_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_1_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_2 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_2_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_2_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_3 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_3_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_3_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_4 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_4_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_4_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_5 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_5_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_5_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_6 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_6_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_6_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_7 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_7_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_7_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_8 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_8_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_8_value }}</td>
        </tr>
      {% endif %}

      {% if block.settings.show_spec_9 %}
        <tr class="ai-product-specs__row-{{ ai_gen_id }}">
          <td class="ai-product-specs__label-{{ ai_gen_id }}">{{ block.settings.spec_9_label }}</td>
          <td class="ai-product-specs__value-{{ ai_gen_id }}">{{ block.settings.spec_9_value }}</td>
        </tr>
      {% endif %}
    </table>

    {% if block.settings.show_footer_notes %}
      <div class="ai-product-specs__footer-{{ ai_gen_id }}">
        {% if block.settings.note_1 != blank %}
          <p class="ai-product-specs__note-{{ ai_gen_id }}">{{ block.settings.note_1 }}</p>
        {% endif %}
        {% if block.settings.note_2 != blank %}
          <p class="ai-product-specs__note-{{ ai_gen_id }}">{{ block.settings.note_2 }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

