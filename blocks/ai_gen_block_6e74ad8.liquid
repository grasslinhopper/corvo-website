{% doc %}
  @prompt
    I want a section with an image on the left and on the right: title, subheading, 5 dropdown options., I eant to be able to format the type of lettering of heading and subheading to use the themes i already have, I want to be able to format every text. , Add link after the subhedaing 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-accordion-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-image-accordion__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-image-accordion__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-image-accordion__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-image-accordion__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
  }

  .ai-image-accordion__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-accordion__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-accordion__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-image-accordion__header-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-image-accordion__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-image-accordion__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    line-height: 1.5;
  }

  .ai-image-accordion__link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: {{ block.settings.link_font.family }}, {{ block.settings.link_font.fallback_families }};
    font-weight: {{ block.settings.link_font.weight }};
    font-style: {{ block.settings.link_font.style }};
    font-size: {{ block.settings.link_size }}px;
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_underline }};
    transition: opacity 0.3s ease;
  }

  .ai-image-accordion__link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-image-accordion__link-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .ai-image-accordion__link-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 2;
  }

  .ai-image-accordion__items-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-image-accordion__item-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.divider_color }};
  }

  .ai-image-accordion__button-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.accordion_title_font.family }}, {{ block.settings.accordion_title_font.fallback_families }};
    font-weight: {{ block.settings.accordion_title_font.weight }};
    font-style: {{ block.settings.accordion_title_font.style }};
    font-size: {{ block.settings.accordion_title_size }}px;
    transition: opacity 0.3s ease;
  }

  .ai-image-accordion__button-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-image-accordion__icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .ai-image-accordion__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.text_color }};
    stroke-width: 2;
  }

  .ai-image-accordion__item-{{ ai_gen_id }}.active .ai-image-accordion__icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-image-accordion__panel-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-image-accordion__panel-content-{{ ai_gen_id }} {
    padding-bottom: 20px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.accordion_content_font.family }}, {{ block.settings.accordion_content_font.fallback_families }};
    font-weight: {{ block.settings.accordion_content_font.weight }};
    font-style: {{ block.settings.accordion_content_font.style }};
    font-size: {{ block.settings.accordion_content_size }}px;
    line-height: 1.6;
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .ai-image-accordion__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 32px 16px;
    }

    .ai-image-accordion__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-image-accordion__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<image-accordion-{{ ai_gen_id }}
  class="ai-image-accordion-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-image-accordion__container-{{ ai_gen_id }}">
    <div class="ai-image-accordion__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-image-accordion__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-accordion__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-accordion__empty-state-{{ ai_gen_id }}">
            Add an image
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-image-accordion__content-{{ ai_gen_id }}">
      <div class="ai-image-accordion__header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-image-accordion__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-image-accordion__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
        {% if block.settings.link_text != blank and block.settings.link_url != blank %}
          <a href="{{ block.settings.link_url }}" class="ai-image-accordion__link-{{ ai_gen_id }}">
            {{ block.settings.link_text }}
            {% if block.settings.show_link_arrow %}
              <span class="ai-image-accordion__link-icon-{{ ai_gen_id }}">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </span>
            {% endif %}
          </a>
        {% endif %}
      </div>

      <div class="ai-image-accordion__items-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign title_key = 'accordion_' | append: i | append: '_title'
            assign content_key = 'accordion_' | append: i | append: '_content'
            assign title = block.settings[title_key]
            assign content = block.settings[content_key]
          %}

          {% if title != blank %}
            <div class="ai-image-accordion__item-{{ ai_gen_id }}" data-accordion-item="{{ i }}">
              <button
                class="ai-image-accordion__button-{{ ai_gen_id }}"
                aria-expanded="false"
                aria-controls="ai-accordion-panel-{{ ai_gen_id }}-{{ i }}"
              >
                <span>{{ title }}</span>
                <span class="ai-image-accordion__icon-{{ ai_gen_id }}">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>
              <div
                class="ai-image-accordion__panel-{{ ai_gen_id }}"
                id="ai-accordion-panel-{{ ai_gen_id }}-{{ i }}"
              >
                <div class="ai-image-accordion__panel-content-{{ ai_gen_id }}">
                  {{ content }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</image-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-image-accordion__item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          const button = item.querySelector('.ai-image-accordion__button-{{ ai_gen_id }}');
          const panel = item.querySelector('.ai-image-accordion__panel-{{ ai_gen_id }}');
          const panelContent = panel.querySelector('.ai-image-accordion__panel-content-{{ ai_gen_id }}');

          button.addEventListener('click', () => {
            const isActive = item.classList.contains('active');

            if (isActive) {
              item.classList.remove('active');
              button.setAttribute('aria-expanded', 'false');
              panel.style.maxHeight = null;
            } else {
              item.classList.add('active');
              button.setAttribute('aria-expanded', 'true');
              panel.style.maxHeight = panelContent.scrollHeight + 'px';
            }
          });
        });
      }
    }

    customElements.define('image-accordion-{{ ai_gen_id }}', ImageAccordion{{ ai_gen_id }});
  })();
</script>

