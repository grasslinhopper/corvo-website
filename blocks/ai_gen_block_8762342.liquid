{% doc %}
  @prompt
    Create a three-column feature highlights section with the following specifications:
    Layout:
    
    Single row with 3 equal-width columns
    Light gray/off-white background
    Centered content in each column
    Generous padding above and below (60-80px)
    
    Column Structure (each contains):
    
    Icon at the top (line-style icon, centered, approximately 60-80px size)
    Heading below the icon (serif or elegant font, centered)
    Descriptive paragraph text (2-3 lines, centered, regular weight)
    
    Column 1 - Short Lead Times:
    
    Icon: Clock with speed lines (indicating fast delivery)
    Heading: 'Short Lead Times'
    Text: 'Orders fulfilled in just 3 to 4 weeks upon project/sample approval, ensuring prompt delivery of your orders'
    
    Column 2 - Premium Assistance:
    
    Icon: Hand holding/supporting a person figure
    Heading: 'Premium assistance'
    Text: 'Our customer-driven approach means clients receive tailored support from our sales team and designers'
    
    Column 3 - Vertical Integration:
    
    Icon: Gear/cog with circuit board connections
    Heading: 'Vertical integration'
    Text: 'With in-house dyeing capabilities and a talented design team, we provide unparalleled flexibility and meticulous attention to detail'
    
    Style Guidelines:
    
    Icons should be thin line style, black, minimal and consistent
    Elegant serif or clean sans-serif typography for headings
    Body text in dark gray
    Adequate spacing between icon, heading, and text (20-30px between elements)
    Mobile responsive: stack into single column on small screens
    Match the sophisticated, high-end aesthetic of the product page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-highlights-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-feature-highlights__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-feature-highlights__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-feature-highlights__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-feature-highlights__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
  }

  .ai-feature-highlights__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-feature-highlights__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-feature-highlights__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
    max-width: 350px;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-highlights__grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_row_gap }}px;
    }

    .ai-feature-highlights__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-feature-highlights__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-feature-highlights__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<feature-highlights-{{ ai_gen_id }} class="ai-feature-highlights-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-highlights__container-{{ ai_gen_id }}">
    <div class="ai-feature-highlights__grid-{{ ai_gen_id }}">
      <div class="ai-feature-highlights__column-{{ ai_gen_id }}">
        <div class="ai-feature-highlights__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
            <path d="M16 2 L20 6 M20 2 L16 6"></path>
          </svg>
        </div>
        <h3 class="ai-feature-highlights__heading-{{ ai_gen_id }}">{{ block.settings.feature_1_heading }}</h3>
        <p class="ai-feature-highlights__text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</p>
      </div>

      <div class="ai-feature-highlights__column-{{ ai_gen_id }}">
        <div class="ai-feature-highlights__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M12 14 L12 10 M10 12 L14 12"></path>
            <path d="M2 8 L6 12 L2 16"></path>
          </svg>
        </div>
        <h3 class="ai-feature-highlights__heading-{{ ai_gen_id }}">{{ block.settings.feature_2_heading }}</h3>
        <p class="ai-feature-highlights__text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</p>
      </div>

      <div class="ai-feature-highlights__column-{{ ai_gen_id }}">
        <div class="ai-feature-highlights__icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 1v6m0 6v10"></path>
            <path d="M17 7l-5 5-5-5"></path>
            <path d="M7 17l5-5 5 5"></path>
            <rect x="3" y="3" width="4" height="4" rx="1"></rect>
            <rect x="17" y="3" width="4" height="4" rx="1"></rect>
            <rect x="3" y="17" width="4" height="4" rx="1"></rect>
            <rect x="17" y="17" width="4" height="4" rx="1"></rect>
          </svg>
        </div>
        <h3 class="ai-feature-highlights__heading-{{ ai_gen_id }}">{{ block.settings.feature_3_heading }}</h3>
        <p class="ai-feature-highlights__text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</p>
      </div>
    </div>
  </div>
</feature-highlights-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureHighlights{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('feature-highlights-{{ ai_gen_id }}', FeatureHighlights{{ ai_gen_id }});
  })();
</script>

