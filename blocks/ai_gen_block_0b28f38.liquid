{% doc %}
  @prompt
    clean, luxurious, elegant, footer. typical of a high end luxury brand
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-luxury-footer__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .ai-luxury-footer__top-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 60px;
    padding-bottom: {{ block.settings.divider_spacing }}px;
    border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-luxury-footer__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-luxury-footer__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 400;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
    margin: 0;
    color: {{ block.settings.text_color }};
  }

  .ai-luxury-footer__links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-luxury-footer__link-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    letter-spacing: {{ block.settings.link_letter_spacing }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-luxury-footer__link-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-luxury-footer__newsletter-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-luxury-footer__newsletter-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    letter-spacing: {{ block.settings.link_letter_spacing }}px;
    opacity: 0.8;
    line-height: 1.6;
  }

  .ai-luxury-footer__newsletter-form-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    border-bottom: 1px solid {{ block.settings.text_color }};
    padding-bottom: 8px;
  }

  .ai-luxury-footer__newsletter-input-{{ ai_gen_id }} {
    flex: 1;
    background: transparent;
    border: none;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.link_size }}px;
    letter-spacing: {{ block.settings.link_letter_spacing }}px;
    padding: 8px 0;
    outline: none;
  }

  .ai-luxury-footer__newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.text_color }};
    opacity: 0.5;
  }

  .ai-luxury-footer__newsletter-button-{{ ai_gen_id }} {
    background: transparent;
    border: none;
    color: {{ block.settings.text_color }};
    cursor: pointer;
    padding: 8px 0;
    font-size: {{ block.settings.link_size }}px;
    letter-spacing: {{ block.settings.link_letter_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-luxury-footer__newsletter-button-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-luxury-footer__newsletter-success-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    opacity: 0.8;
    margin-top: 8px;
  }

  .ai-luxury-footer__newsletter-error-{{ ai_gen_id }} {
    font-size: {{ block.settings.link_size }}px;
    opacity: 0.8;
    margin-top: 8px;
  }

  .ai-luxury-footer__bottom-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: {{ block.settings.divider_spacing }}px;
    gap: 40px;
    flex-wrap: wrap;
  }

  .ai-luxury-footer__copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.copyright_size }}px;
    letter-spacing: {{ block.settings.link_letter_spacing }}px;
    opacity: 0.6;
  }

  .ai-luxury-footer__social-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-luxury-footer__social-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    opacity: 0.6;
    transition: opacity 0.3s ease;
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
  }

  .ai-luxury-footer__social-link-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-luxury-footer__social-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-footer__container-{{ ai_gen_id }} {
      padding: 0 20px;
    }

    .ai-luxury-footer__top-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-luxury-footer__bottom-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
  }
{% endstyle %}

<luxury-footer-{{ ai_gen_id }} class="ai-luxury-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-footer__container-{{ ai_gen_id }}">
    <div class="ai-luxury-footer__top-{{ ai_gen_id }}">
      {% if block.settings.show_column_1 %}
        <div class="ai-luxury-footer__column-{{ ai_gen_id }}">
          {% if block.settings.column_1_heading != blank %}
            <h3 class="ai-luxury-footer__heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
          {% endif %}
          <ul class="ai-luxury-footer__links-{{ ai_gen_id }}">
            {% if block.settings.column_1_link_1_text != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_1_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_2_text != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_2_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_3_text != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_3_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_1_link_4_text != blank %}
              <li>
                <a href="{{ block.settings.column_1_link_4_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_1_link_4_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_column_2 %}
        <div class="ai-luxury-footer__column-{{ ai_gen_id }}">
          {% if block.settings.column_2_heading != blank %}
            <h3 class="ai-luxury-footer__heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
          {% endif %}
          <ul class="ai-luxury-footer__links-{{ ai_gen_id }}">
            {% if block.settings.column_2_link_1_text != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_1_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_2_text != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_2_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_3_text != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_3_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_2_link_4_text != blank %}
              <li>
                <a href="{{ block.settings.column_2_link_4_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_2_link_4_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_column_3 %}
        <div class="ai-luxury-footer__column-{{ ai_gen_id }}">
          {% if block.settings.column_3_heading != blank %}
            <h3 class="ai-luxury-footer__heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
          {% endif %}
          <ul class="ai-luxury-footer__links-{{ ai_gen_id }}">
            {% if block.settings.column_3_link_1_text != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_1_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_1_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_2_text != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_2_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_2_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_3_text != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_3_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_3_text }}
                </a>
              </li>
            {% endif %}
            {% if block.settings.column_3_link_4_text != blank %}
              <li>
                <a href="{{ block.settings.column_3_link_4_url }}" class="ai-luxury-footer__link-{{ ai_gen_id }}">
                  {{ block.settings.column_3_link_4_text }}
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endif %}

      {% if block.settings.show_newsletter %}
        <div class="ai-luxury-footer__column-{{ ai_gen_id }}">
          {% if block.settings.newsletter_heading != blank %}
            <h3 class="ai-luxury-footer__heading-{{ ai_gen_id }}">{{ block.settings.newsletter_heading }}</h3>
          {% endif %}
          <div class="ai-luxury-footer__newsletter-{{ ai_gen_id }}">
            {% if block.settings.newsletter_text != blank %}
              <p class="ai-luxury-footer__newsletter-text-{{ ai_gen_id }}">{{ block.settings.newsletter_text }}</p>
            {% endif %}
            {%- form 'customer', class: 'ai-luxury-footer__newsletter-form-wrapper-{{ ai_gen_id }}' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="ai-luxury-footer__newsletter-form-{{ ai_gen_id }}">
                <input
                  type="email"
                  name="contact[email]"
                  class="ai-luxury-footer__newsletter-input-{{ ai_gen_id }}"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="ai-luxury-footer-newsletter-error-{{ ai_gen_id }}"
                  {% endif %}
                  {% if form.posted_successfully? %}
                    aria-describedby="ai-luxury-footer-newsletter-success-{{ ai_gen_id }}"
                  {% endif %}
                  placeholder="{{ block.settings.newsletter_placeholder }}"
                  required
                >
                <button type="submit" class="ai-luxury-footer__newsletter-button-{{ ai_gen_id }}">
                  {{ block.settings.newsletter_button_text }}
                </button>
              </div>
              {%- if form.errors -%}
                <div id="ai-luxury-footer-newsletter-error-{{ ai_gen_id }}" class="ai-luxury-footer__newsletter-error-{{ ai_gen_id }}">
                  {{ form.errors.messages.email }}
                </div>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <div id="ai-luxury-footer-newsletter-success-{{ ai_gen_id }}" class="ai-luxury-footer__newsletter-success-{{ ai_gen_id }}">
                  {{ block.settings.newsletter_success_message }}
                </div>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-luxury-footer__bottom-{{ ai_gen_id }}">
      <div class="ai-luxury-footer__copyright-{{ ai_gen_id }}">
        {{ block.settings.copyright_text }}
      </div>

      {% if block.settings.show_social %}
        <ul class="ai-luxury-footer__social-{{ ai_gen_id }}">
          {% if block.settings.social_instagram != blank %}
            <li>
              <a href="{{ block.settings.social_instagram }}" class="ai-luxury-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg class="ai-luxury-footer__social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            </li>
          {% endif %}
          {% if block.settings.social_facebook != blank %}
            <li>
              <a href="{{ block.settings.social_facebook }}" class="ai-luxury-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg class="ai-luxury-footer__social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            </li>
          {% endif %}
          {% if block.settings.social_twitter != blank %}
            <li>
              <a href="{{ block.settings.social_twitter }}" class="ai-luxury-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Twitter">
                <svg class="ai-luxury-footer__social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                </svg>
              </a>
            </li>
          {% endif %}
          {% if block.settings.social_pinterest != blank %}
            <li>
              <a href="{{ block.settings.social_pinterest }}" class="ai-luxury-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Pinterest">
                <svg class="ai-luxury-footer__social-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M8.5 14.5c.5 2 1.5 3.5 3 3.5 2.5 0 3.5-4 3.5-6.5 0-2-1-3.5-3-3.5s-3.5 1.5-3.5 3.5c0 1.5.5 2.5 1.5 2.5 1 0 1.5-1 1.5-2"></path>
                </svg>
              </a>
            </li>
          {% endif %}
        </ul>
      {% endif %}
    </div>
  </div>
</luxury-footer-{{ ai_gen_id }}>

<script>
  (function() {
    class LuxuryFooter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupNewsletterForm();
      }

      setupNewsletterForm() {
        const form = this.querySelector('.ai-luxury-footer__newsletter-form-wrapper-{{ ai_gen_id }}');
        if (!form) return;

        form.addEventListener('submit', function(event) {
          const emailInput = form.querySelector('.ai-luxury-footer__newsletter-input-{{ ai_gen_id }}');
          if (emailInput && !emailInput.value.trim()) {
            event.preventDefault();
          }
        });
      }
    }

    customElements.define('luxury-footer-{{ ai_gen_id }}', LuxuryFooter{{ ai_gen_id }});
  })();
</script>

