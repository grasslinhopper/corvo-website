{% doc %}
  @prompt
    Create a full-width feature benefits section with the following specifications:
    Layout:
    
    Single row with 4 equal-width columns
    Light gray/off-white background
    Centered content in each column
    Adequate padding above and below (around 60-80px)
    
    Column Structure (each column contains):
    
    Icon at the top (simple line icon, centered)
    Uppercase heading below the icon (letter-spaced, dark text)
    Descriptive text below the heading (2 lines, centered, regular weight)
    
    Column 1 - Express Delivery:
    
    Box/package icon
    Heading: 'EXPRESS DELIVERY'
    Text: 'DHL express delivery worldwide'
    
    Column 2 - Free Returns:
    
    Circular arrow/return icon
    Heading: 'FREE RETURNS'
    Text: 'Free return for 30 days for any order delivered in France'
    
    Column 3 - Customer Service:
    
    Chat bubble/message icon
    Heading: 'AVAILABLE CUSTOMER SERVICE'
    Text: 'Available via Whatsapp on +33123456789'
    
    Column 4 - Payment Options:
    
    Credit card/payment icon
    Heading: 'PAYMENT IN 3X'
    Text: 'Take advantage of a payment in 3x without fees from $100 of purchase'
    
    Style Guidelines:
    
    Icons should be thin line style, minimal, matching
    Clean, elegant typography
    Generous spacing between icon, heading, and text
    Mobile responsive: stack into 2x2 grid or single column
    Text should be dark gray/charcoal on light background
    Consistent with the minimalist, high-end aesthetic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-benefits-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-benefits-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-benefits-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-benefits-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-benefits-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
    stroke-width: {{ block.settings.icon_stroke_width }};
  }

  .ai-benefits-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    fill: none;
  }

  .ai-benefits-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-benefits-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
    max-width: 250px;
  }

  @media screen and (max-width: 989px) {
    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.column_gap | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-benefits-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.7 }}px 0;
    }

    .ai-benefits-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.6 }}px;
    }

    .ai-benefits-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-benefits-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.9 }}px;
    }

    .ai-benefits-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<feature-benefits-{{ ai_gen_id }} class="ai-benefits-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-benefits-container-{{ ai_gen_id }}">
    <div class="ai-benefits-grid-{{ ai_gen_id }}">
      <div class="ai-benefits-column-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <h3 class="ai-benefits-heading-{{ ai_gen_id }}">{{ block.settings.benefit_1_heading }}</h3>
        <p class="ai-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_1_text }}</p>
      </div>

      <div class="ai-benefits-column-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </div>
        <h3 class="ai-benefits-heading-{{ ai_gen_id }}">{{ block.settings.benefit_2_heading }}</h3>
        <p class="ai-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_2_text }}</p>
      </div>

      <div class="ai-benefits-column-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <h3 class="ai-benefits-heading-{{ ai_gen_id }}">{{ block.settings.benefit_3_heading }}</h3>
        <p class="ai-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_3_text }}</p>
      </div>

      <div class="ai-benefits-column-{{ ai_gen_id }}">
        <div class="ai-benefits-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        </div>
        <h3 class="ai-benefits-heading-{{ ai_gen_id }}">{{ block.settings.benefit_4_heading }}</h3>
        <p class="ai-benefits-text-{{ ai_gen_id }}">{{ block.settings.benefit_4_text }}</p>
      </div>
    </div>
  </div>
</feature-benefits-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureBenefits{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('feature-benefits-{{ ai_gen_id }}', FeatureBenefits{{ ai_gen_id }});
  })();
</script>

