<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">

    {%- comment -%}
    Corvo addition: every page tells search engines and AI assistants what it is. A title always names Corvo, the list
    of all rugs is not called "Products", and a page without a description of its own gets a factual one. The page of
    a project of the Portfolio is titled by the name of the project.
    {%- endcomment -%}
    {%- liquid
      assign seo_title = page_title
      assign seo_description = page_description

      # A page whose search title and description are written in the theme, with the shop's facts filled in
      assign seo_key = blank

      if request.page_type == 'page'
        assign seo_handle = page.handle | replace: '-', '_'
        assign seo_handles = 'raw_materials|colours|bespoke_service|tailor_your_rug|care_faq|craftmanship|gallery|portfolio|resources|sales_tools|catalogue|about_us|sorema_group|designers' | split: '|'

        if seo_handles contains seo_handle
          assign seo_key = 'general.corvo.seo.' | append: seo_handle
        endif
      endif

      if request.page_type == 'index'
        assign seo_title = 'general.corvo.home_title' | t
      elsif request.page_type == 'collection' and collection.handle == 'all'
        assign seo_title = 'general.corvo.all_rugs_title' | t
      elsif request.page_type == 'blog' and blog.handle == 'news' and current_tags == blank and page_title == blog.title
        assign seo_title = 'general.corvo.journal_title' | t
      elsif seo_key != blank and page_title == page.title
        assign seo_title = seo_key | append: '.title' | t
      elsif request.page_type == 'metaobject' and metaobject.system.type == 'project'
        assign seo_title = 'portfolio.seo_title' | t: title: metaobject.title.value
      elsif request.page_type == 'metaobject' and metaobject.system.type == 'designer'
        assign seo_title = 'designers.seo_title' | t: name: metaobject.name.value
      endif

      if seo_title == blank
        assign seo_title = shop.name
      endif

      # The name of the shop is added once: a title that already ends in "CORVO" or "Corvo" is left as it is
      assign seo_title_lower = seo_title | downcase
      assign shop_name_lower = shop.name | downcase

      unless seo_title_lower contains shop_name_lower
        assign seo_title = seo_title | append: ' | ' | append: shop.name
      endunless

      # A page described in the theme keeps that description unless one was typed for it in Shopify. Otherwise Shopify
      # would fill the description with the first lines of the page's own text.
      if seo_key != blank and page.metafields.global.description_tag == blank
        assign seo_description = blank
      endif

      if seo_description == blank
        if request.page_type == 'index'
          assign seo_description = 'general.corvo.description' | t
        elsif request.page_type == 'blog' and blog.handle == 'news' and current_tags == blank
          assign seo_description = 'general.corvo.journal_description' | t
        elsif seo_key != blank
          assign seo_description = seo_key | append: '.description' | t
        elsif request.page_type == 'collection' and collection.handle == 'all'
          assign seo_description = 'general.corvo.all_rugs_description' | t: count: collection.products_count
        elsif request.page_type == 'collection' and collection.description != blank
          assign seo_description = collection.description | strip_html | strip_newlines | truncate: 160
        elsif request.page_type == 'page' and page.content != blank
          assign seo_description = page.content | strip_html | strip_newlines | truncate: 160
        elsif request.page_type == 'list-collections'
          assign seo_description = 'general.corvo.collections_description' | t
        elsif request.page_type == 'metaobject' and metaobject.system.type == 'project'
          assign seo_description = metaobject.title.value

          if metaobject.location.value != blank
            assign seo_description = seo_description | append: ', ' | append: metaobject.location.value
          endif

          assign seo_description = 'portfolio.seo_description' | t | prepend: ': ' | prepend: seo_description
        elsif request.page_type == 'metaobject' and metaobject.system.type == 'designer'
          assign seo_description = 'designers.seo_description' | t: name: metaobject.name.value
        endif
      endif

      # Markers such as [max_size] are filled in from the shop's own facts: see the "corvo-fill" snippet
      if seo_description contains '['
        capture seo_description
          render 'corvo-fill', text: seo_description
        endcapture

        assign seo_description = seo_description | strip
      endif
    -%}

    <title>{{ seo_title }}{% if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif %}</title>

    {%- if seo_description != blank -%}
      <meta name="description" content="{{ seo_description | escape }}">
    {%- endif -%}

    {%- comment -%}Corvo addition: an example project (ticked "Preview only") is kept out of search engines{%- endcomment -%}
    {%- if request.page_type == 'metaobject' and metaobject.example.value -%}
      <meta name="robots" content="noindex">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    {%- comment -%}
    Corvo addition: the brand fonts, Canela and Graphik (snippets/brand-fonts.liquid), preload their two most used files.
    The fonts of the font pickers are preloaded only while no brand fonts are in use (neither these nor Adobe Fonts).
    {%- endcomment -%}
    {%- capture brand_fonts_state -%}{%- render 'brand-fonts', part: 'state' -%}{%- endcapture -%}

    {%- if brand_fonts_state == 'on' -%}
      {%- render 'brand-fonts', part: 'preload' -%}
    {%- elsif settings.adobe_fonts_id == blank -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {%- unless settings.heading_font.system? -%}
        <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
      {%- endunless -%}

      {%- unless settings.text_font.system? -%}
        <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    {%- render 'social-meta-tags', seo_title: seo_title, seo_description: seo_description -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'adobe-fonts' -%}
    {%- render 'js-variables' -%}

    {%- if request.page_type == 'gift_card' -%}
      <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}

    {%- comment -%}Corvo addition: the rug card and the lists of rugs. After the theme's own styles, which it refines.{%- endcomment -%}
    {{- 'corvo-cards.css' | asset_url | stylesheet_tag -}}

    {%- comment -%}Corvo addition: the brand fonts and their styles, after every other style, which they refine{%- endcomment -%}
    {%- if brand_fonts_state == 'on' -%}
      {%- render 'brand-fonts' -%}
    {%- endif -%}
  </head>

  {% liquid
    assign features_class = ''
  
    if settings.show_button_transition
      assign features_class = features_class | append: 'features--button-transition '
    endif
  
    if settings.show_image_zoom_on_hover
      assign features_class = features_class | append: 'features--zoom-image '
    endif
  %}

  <body class="{{ features_class }} color-scheme color-scheme--{{ settings.default_color_scheme.id }}">
    {%- render 'shadow-dom-templates' -%}

    <loading-bar class="loading-bar" aria-hidden="true"></loading-bar>
    <a href="#main" allow-hash-change class="skip-to-content sr-only">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- comment -%}
    This placeholder will be filled to screen readers for any kind of announcements
    {%- endcomment -%}
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
      <span id="status-announcement"></span>
    </div>

    <div class="sr-only" role="alert" aria-live="assertive" aria-atomic="true">
      <span id="error-announcement"></span>
    </div>

    <span id="header-scroll-tracker" style="position: absolute; width: 1px; height: 1px; top: var(--header-scroll-tracker-offset, 10px); left: 0;">
      {%- comment -%}
        This allows our theme to track when the user has scrolled a given amount of pixels, without relying on a global scroll listener. This helps
        to improve performance and reduce reflows.
      {%- endcomment -%}
    </span>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
    {%- endif -%}

    <main id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
      IMPLEMENTATION NOTE: For best semantics, having the footer group outside the main would be slightly better, but
        moving it inside the main allows to have all the sections (including sections inside the footer group) to be
        consecutive, and hence having a cleaner margin collapsing management.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>
  </body>
</html>
