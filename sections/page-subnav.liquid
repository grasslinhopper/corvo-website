{%- comment -%}
  Page sub-navigation (Corvo addition)

  Finds the group of sibling pages the current page belongs to by reading the header menu, then renders either:
  - "tabs": a bar that sticks under the header and marks the current page, or
  - "pager": previous / next links for the foot of the page.

  Because it reads the menu, adding or reordering pages in the menu updates every bar. It renders nothing on a page
  that has no siblings in the menu.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign siblings = null
  assign group_title = ''

  for link in menu.links
    if link.links.size == 0
      continue
    endif

    assign found = false

    for sub_link in link.links
      for sub_sub_link in sub_link.links
        if sub_sub_link.current
          assign siblings = sub_link.links
          assign group_title = sub_link.title
          assign found = true
          break
        endif
      endfor

      if found
        break
      endif

      if sub_link.current
        assign siblings = link.links
        assign group_title = link.title
        assign found = true
        break
      endif
    endfor

    if found
      break
    endif
  endfor
-%}

{%- if siblings != null and siblings.size > 1 -%}
  {%- if section.settings.style == 'tabs' -%}
    <nav class="subnav subnav--tabs{% unless section.settings.sticky %} subnav--static{% endunless %}" aria-label="{{ group_title | escape }}">
      <div class="subnav__inner">
        <p class="subnav__title">{{ group_title | escape }}</p>

        {%- comment -%}
          A bar with more tabs than fit scrolls sideways. On a computer two arrows move it; on a phone a finger does.
          The script below shows the arrows only when there is more to see, and brings the current tab into view.
        {%- endcomment -%}
        <div class="subnav__scroller">
          <button type="button" class="subnav__arrow" data-subnav-arrow="-1" aria-label="{{ 'general.accessibility.previous' | t | escape }}" hidden>
            {%- render 'icon' with 'chevron-left' -%}
          </button>

          <ul class="subnav__list unstyled-list" role="list">
            {%- for link in siblings -%}
              <li>
                {%- comment -%}On a page with no heading of its own, its name in the bar is the main heading{%- endcomment -%}
                {%- if link.current and section.settings.current_as_title -%}
                  <h1 class="subnav__heading"><a href="{{ link.url }}" class="subnav__link" aria-current="page"><span class="sr-only">{{ group_title | escape }}: </span>{{ link.title | escape }}</a></h1>
                {%- else -%}
                  <a href="{{ link.url }}" class="subnav__link" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          <button type="button" class="subnav__arrow" data-subnav-arrow="1" aria-label="{{ 'general.accessibility.next' | t | escape }}" hidden>
            {%- render 'icon' with 'chevron-right' -%}
          </button>
        </div>
      </div>
    </nav>

    <script>
      (() => {
        const nav = document.currentScript.previousElementSibling,
          list = nav.querySelector('.subnav__list');

        if (!list) {
          return;
        }

        const arrows = Array.from(nav.querySelectorAll('[data-subnav-arrow]')),
          current = list.querySelector('[aria-current="page"]'),
          direction = () => (getComputedStyle(list).direction === 'rtl' ? -1 : 1);

        // What is hidden before and after: the bar fades out on that side, and the arrow of that side shows
        const refresh = () => {
          const hidden = list.scrollWidth - list.clientWidth,
            passed = Math.abs(list.scrollLeft),
            before = passed > 2,
            after = hidden - passed > 2;

          nav.classList.toggle('has-more-before', before);
          nav.classList.toggle('has-more-after', after);

          arrows.forEach((arrow) => {
            arrow.hidden = !(arrow.dataset.subnavArrow === '-1' ? before : after);
          });
        };

        const showCurrent = () => {
          if (current && list.scrollWidth > list.clientWidth) {
            list.scrollLeft += current.getBoundingClientRect().left - list.getBoundingClientRect().left - (list.clientWidth - current.offsetWidth) / 2;
          }

          refresh();
        };

        arrows.forEach((arrow) => {
          arrow.addEventListener('click', () => {
            list.scrollBy({ left: parseInt(arrow.dataset.subnavArrow, 10) * direction() * list.clientWidth * 0.7, behavior: 'smooth' });
          });
        });

        list.addEventListener('scroll', refresh, { passive: true });
        window.addEventListener('resize', refresh, { passive: true });
        window.addEventListener('load', showCurrent, { once: true });

        showCurrent();
      })();
    </script>
  {%- else -%}
                <a href="{{ link.url }}" class="subnav__link" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </nav>

    {%- comment -%}Where the bar is wider than the screen it scrolls sideways: the tab of the current page is brought into view{%- endcomment -%}
    <script>
      (() => {
        const list = document.currentScript.previousElementSibling.querySelector('.subnav__list'),
          current = list ? list.querySelector('[aria-current="page"]') : null;

        if (current && list.scrollWidth > list.clientWidth) {
          list.scrollLeft += current.getBoundingClientRect().left - list.getBoundingClientRect().left - (list.clientWidth - current.offsetWidth) / 2;
        }
      })();
    </script>
  {%- else -%}
    {%- liquid
      assign previous_link = null
      assign next_link = null
      assign take_next = false

      for link in siblings
        if take_next
          assign next_link = link
          break
        endif

        if link.current
          assign take_next = true
        else
          assign previous_link = link
        endif
      endfor
    -%}

    {%- if previous_link != null or next_link != null -%}
      <nav class="subnav subnav--pager" aria-label="{{ group_title | escape }}">
        <div class="subnav-pager">
          {%- if previous_link != null -%}
            <a href="{{ previous_link.url }}" class="subnav-pager__link subnav-pager__link--previous">
              <span class="subnav-pager__label">{{ section.settings.previous_label | escape }}</span>
              <span class="subnav-pager__title">{{ previous_link.title | escape }}</span>
            </a>
          {%- else -%}
            <span></span>
          {%- endif -%}

          {%- if next_link != null -%}
            <a href="{{ next_link.url }}" class="subnav-pager__link subnav-pager__link--next">
              <span class="subnav-pager__label">{{ section.settings.next_label | escape }}</span>
              <span class="subnav-pager__title">{{ next_link.title | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </nav>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  /* The tab bar sticks under the header and follows it when the header hides on scroll */
  .shopify-section--page-subnav:has(.subnav--tabs:not(.subnav--static)) {
    position: sticky;
    inset-block-start: var(--sticky-area-height, 0px);
    z-index: 2;
    transition: inset-block-start 0.15s ease-in-out;
  }

  .subnav--tabs {
    background: rgb(var(--background));
    border-block-end: 1px solid rgb(var(--text-color) / 0.12);
  }

  .subnav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-inline: var(--container-gutter);
  }

  /* The group name is a label, not a tab: full strength, set apart by a rule */
  .subnav__title {
    display: none;
    flex: none;
    align-self: stretch;
    align-items: center;
    margin: 0;
    padding-inline-end: 2rem;
    border-inline-end: 1px solid rgb(var(--text-color) / 0.12);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  /* The tabs sit on one line. When they do not all fit the line scrolls sideways, and fades out where more is hidden. */
  .subnav__scroller {
    display: flex;
    align-items: stretch;
    min-inline-size: 0;
    margin: 0 auto;
  }

  .subnav__list {
    display: flex;
    flex: 0 1 auto;
    gap: 1.75rem;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .subnav--tabs.has-more-after .subnav__list {
    -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
  }

  .subnav--tabs.has-more-before .subnav__list {
    -webkit-mask-image: linear-gradient(to left, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(to left, #000 calc(100% - 2.5rem), transparent);
  }

  .subnav--tabs.has-more-before.has-more-after .subnav__list {
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 2.5rem, #000 calc(100% - 2.5rem), transparent);
  }

  /* The arrows are for a mouse: a finger scrolls the bar itself */
  .subnav__arrow {
    display: none;
    flex: none;
    place-items: center;
    padding: 0 0.75rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .subnav__arrow svg {
    inline-size: 0.75rem;
    block-size: 0.75rem;
  }

  @media (hover: hover) {
    .subnav__arrow:not([hidden]) {
      display: grid;
    }

    .subnav__arrow:hover {
      opacity: 1;
    }
  }

  .subnav__list::-webkit-scrollbar {
    display: none;
  }

  .subnav__link {
    position: relative;
    display: block;
    padding-block: 0.95rem;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    color: inherit;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .subnav__heading {
    all: unset;
    display: contents;
  }

  .subnav__link[aria-current="page"] {
    opacity: 1;
  }

  .subnav__link[aria-current="page"]::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    height: 1px;
    background: currentColor;
  }

  @media (hover: hover) {
    .subnav__link:hover {
      opacity: 1;
    }
  }

  /* Previous / next links at the foot of a page */
  /* One column on phones (long page names need the full width), two columns from tablet up */
  .subnav-pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-block-start: 1px solid rgb(var(--text-color) / 0.12);
  }

  .subnav-pager > span:empty {
    display: none;
  }

  .subnav-pager__link {
    display: grid;
    gap: 0.6rem;
    padding: clamp(2rem, 5vw, 4rem) var(--container-gutter);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease;
  }

  .subnav-pager__link--next {
    text-align: end;
  }

  .subnav-pager__link--previous + .subnav-pager__link--next {
    border-block-start: 1px solid rgb(var(--text-color) / 0.12);
  }

  .subnav-pager__title {
    overflow-wrap: anywhere;
  }

  @media (min-width: 700px) {
    .subnav-pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .subnav-pager__link--next {
      grid-column: 2;
      border-inline-start: 1px solid rgb(var(--text-color) / 0.12);
    }

    .subnav-pager__link--previous + .subnav-pager__link--next {
      border-block-start: 0;
    }
  }

  .subnav-pager__label {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .subnav-pager__title {
    font-family: var(--heading-font-family);
    font-weight: var(--heading-font-weight);
    font-style: var(--heading-font-style);
    font-size: clamp(1.125rem, 2.2vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: var(--heading-letter-spacing);
    text-transform: var(--heading-text-transform);
  }

  @media (hover: hover) {
    .subnav-pager__link:hover {
      background-color: rgb(var(--text-color) / 0.04);
    }
  }

  @media (min-width: 1000px) {
    .subnav__title {
      display: flex;
    }

    .subnav__list {
      gap: 2.5rem;
    }

    .subnav__link,
    .subnav__title,
    .subnav-pager__label {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shopify-section--page-subnav:has(.subnav--tabs:not(.subnav--static)),
    .subnav__link,
    .subnav__arrow,
    .subnav-pager__link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page sub-navigation",
  "class": "shopify-section--page-subnav",
  "tag": "div",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the sibling pages of the current page, read from the menu below. Nothing is shown on pages that have no siblings in that menu."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "tabs",
          "label": "Tab bar (top of the page)"
        },
        {
          "value": "pager",
          "label": "Previous / next (foot of the page)"
        }
      ],
      "default": "tabs"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Keep the tab bar in view while scrolling",
      "info": "Switch off on pages that have their own bar, such as the rug list.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "current_as_title",
      "label": "The name of the page in the bar is its main heading",
      "info": "Switch on for a page that has no title of its own, so that search engines and AI assistants are told what the page is. Nothing changes to the eye.",
      "default": false
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous label",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next label",
      "default": "Next"
    }
  ],
  "presets": [
    {
      "name": "Page sub-navigation"
    }
  ]
}
{% endschema %}
