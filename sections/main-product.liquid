    border-color: rgb(var(--text-color) / .45);
  }

  :checked + .rug-choice,
  .rug-choice.is-selected {
    color: rgb(var(--text-color));
    border-color: rgb(var(--text-color));
  }

  :focus-visible + .rug-choice,
  .rug-choice:focus-visible {
    outline: 2px solid rgb(var(--text-color));
    outline-offset: 2px;
  }

  .rug-choice--static {
    cursor: default;
  }

  .rug-choice--static:hover {
    border-color: rgb(var(--text-color));
  }

  .rug-choice.is-unavailable {
    opacity: .5;
  }

  .rug-choice__mark {
    border: 1px solid rgb(var(--text-color) / .45);
    border-radius: 50%;
    flex: none;
    width: 1rem;
    height: 1rem;
    position: relative;
  }

  :checked + .rug-choice .rug-choice__mark,
  .rug-choice.is-selected .rug-choice__mark {
    border-color: rgb(var(--text-color));
  }

  :checked + .rug-choice .rug-choice__mark:after,
  .rug-choice.is-selected .rug-choice__mark:after {
    content: "";
    background: rgb(var(--text-color));
    border-radius: 50%;
    position: absolute;
    inset: 3px;
  }

  .rug-choice--link .rug-choice__mark {
    border-style: dashed;
  }

  .rug-choice__text {
    flex-wrap: wrap;
    align-items: baseline;
    gap: .125rem .625rem;
    min-width: 0;
    display: flex;
  }

  .rug-choice__text--stacked {
    flex-direction: column;
    align-items: start;
  }

  .rug-choice__note {
    font-size: var(--text-sm);
  }

  .rug-choice__price {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .rug-choice__arrow {
    display: flex;
  }

  .rug-choice__swatches {
    gap: .25rem;
    display: flex;
  }

  .rug-swatch {
    background: var(--swatch, transparent);
    border: 1px solid rgb(var(--text-color) / .2);
    border-radius: 50%;
    width: .875rem;
    height: .875rem;
    display: block;
  }

  .rug-swatch--multi {
    background: conic-gradient(#b5533c, #c9a24b, #2f6b5a, #34608f, #8b5e3c, #b5533c);
  }

  .rug-summary {
    background: rgb(var(--text-color) / .03);
    border: 1px solid rgb(var(--border-color));
    gap: 1rem;
    padding: 1.25rem;
    display: grid;
  }

  .rug-summary__list,
  .rug-summary__split {
    gap: .375rem;
    margin: 0;
    display: grid;
  }

  .rug-summary__list > div,
  .rug-summary__split > div {
    justify-content: space-between;
    gap: 1rem;
    display: flex;
  }

  .rug-summary__list dt,
  .rug-summary__split dt {
    color: rgb(var(--text-color) / .65);
  }

  .rug-summary__list dd,
  .rug-summary__split dd {
    text-align: end;
    margin: 0;
  }

  .rug-summary__total {
    border-block-start: 1px solid rgb(var(--border-color));
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block-start: 1rem;
    display: flex;
  }

  .rug-summary__amount {
    justify-items: end;
    display: grid;
  }

  .rug-summary__split dd {
    font-variant-numeric: tabular-nums;
  }

  .rug-links {
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: .625rem;
    display: grid;
  }

  .button[data-rug-demo] {
    opacity: .35;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Corvo addition: the shipping step as a demonstration.
   *
   * While the rugs have no "Shipping" option, the rug page shows the two shipping choices on unpublished themes only.
   * The choice changes the summary, and the priority choice cannot be ordered: it switches the order buttons off.
   * Once the rugs carry the option, this element is no longer printed and the theme's own variant logic takes over.
   */
  if (!window.customElements.get('rug-shipping-demo')) {
    const remembered = new Map();

    window.customElements.define('rug-shipping-demo', class extends HTMLElement {
      connectedCallback() {
        this.addEventListener('change', this);

        if (remembered.get(this.dataset.product) === 'express') {
          const express = this.querySelector('input[value="express"]');

          if (express) {
            express.checked = true;
          }
        }

        // The order buttons may be printed again after this element: wait until the page has settled
        window.setTimeout(() => this.apply(), 0);
      }

      handleEvent() {
        remembered.set(this.dataset.product, this.querySelector('input:checked')?.value || 'standard');
        this.apply();
      }

      apply() {
        const input = this.querySelector('input:checked'),
          scope = this.closest('[data-rug-steps]');

        if (!this.isConnected || !input || !scope) {
          return;
        }

        const isExpress = input.value === 'express',
          form = document.forms[this.getAttribute('form')],
          note = this.querySelector('[data-rug-preview-note]');

        [['[data-rug-shipping-label]', input.dataset.label], ['[data-rug-total]', input.dataset.total], ['[data-rug-pay-now]', input.dataset.payNow], ['[data-rug-pay-later]', input.dataset.payLater]].forEach(([selector, text]) => {
          const element = scope.querySelector(selector);

          if (element && text !== undefined) {
            element.textContent = text;
          }
        });

        if (note) {
          note.hidden = !isExpress;
        }

        Array.from(form?.elements || []).filter((element) => element.type === 'submit').forEach((button) => {
          if (isExpress && !button.disabled) {
            button.disabled = true;
            button.dataset.rugDemo = 'true';
          } else if (!isExpress && button.dataset.rugDemo) {
            button.disabled = false;
            delete button.dataset.rugDemo;
          }
        });
      }
    });
  }
{% endjavascript %}

