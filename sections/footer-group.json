          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes. Corvo ships worldwide, working with trusted logistics partners experienced in handling bespoke, made-to-order rugs. Each piece is carefully packed and shipped from Portugal to ensure it arrives in perfect condition, wherever your project is located.</p>"
          }
