            "link_style": "solid"
          }
        },
        "image_with_text_MwKbWK": {
          "type": "image_with_text",
          "settings": {
            "image": "shopify://shop_images/CORVO_FINAL-72.jpg",
            "subheading": "#2",
            "title": "we design your idea",
            "content": "<p>Your vision is our starting point. Our design team transforms your ideas into tangible proposals, sending exclusive artworks for approval, ensuring every detail aligns with your expectations before we move to production.</p>",
