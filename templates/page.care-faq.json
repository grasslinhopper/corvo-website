        "q_made_to_order": {
          "type": "question",
          "settings": {
            "question": "Are Corvo rugs made to order?",
            "answer": "<p>Yes. Every Corvo rug is made to order in our Portuguese atelier, hand-tufted for the room it will live in.</p>"
          }
        },
        "q_customization": {
          "type": "question",
          "settings": {
            "question": "Can I customize the size, shape and colours?",
            "answer": "<p>Yes. Dimensions, shape, materials and an infinite range of colours can all be tailored to your project. We prepare samples for your approval before production begins.</p>"
          }
        },
        "q_start_bespoke": {
          "type": "question",
          "settings": {
            "question": "How do I start a bespoke project?",
            "answer": "<p>Write to our design concierge through our <a href=\"/pages/contact\">contact page</a>. From there, the path is simple: consultation, design, sampling, production.</p>"
          }
        },
        "cat_materials": {
          "type": "category",
          "settings": {
            "title": "Materials & craft",
            "icon": "none"
          }
        },
        "q_materials": {
          "type": "question",
          "settings": {
            "question": "What materials do you use?",
            "answer": "<p>Natural wools — including New Zealand wool — alongside Lyocell and jute. Each is chosen for its feel, its wear and the way it holds light.</p>"
          }
        },
        "cat_orders": {
          "type": "category",
          "settings": {
            "title": "Orders & delivery",
            "icon": "none"
          }
        },
        "q_shipping": {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes. We ship worldwide, insured door-to-door.</p>"
          }
        },
        "q_production": {
          "type": "question",
          "settings": {
            "question": "How long does production take?",
            "answer": "<p>Bespoke pieces are typically ready in 4–6 weeks from design approval.</p>"
          }
        },
        "cat_trade": {
          "type": "category",
          "settings": {
            "title": "Trade",
            "icon": "none"
          }
