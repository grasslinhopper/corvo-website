{
  "sections": {
    "collection-banner": {
      "type": "collection-banner",
      "settings": {
        "color_scheme": "scheme-4",
        "image": "{{ collection.image }}",
        "mobile_image": "{{ collection.image }}",
        "image_size": "lg",
        "allow_transparent_header": false,
        "show_image": true,
        "reveal": true,
        "enable_parallax": true,
        "show_collection_title": true,
        "show_collection_description": true,
        "show_breadcrumb": false,
        "content_width": "xs",
        "overlay_color": "#000000",
        "overlay_opacity": 50
      }
    },
    "main": {
      "type": "main-collection",
      "settings": {
        "color_scheme": "scheme-1",
        "hide_product_information": false,
        "products_per_page": 24,
        "products_per_row_mobile": "1",
        "products_size_desktop": "large",
        "show_grid_mode_selector": false,
        "horizontal_spacing_factor": 0.2,
        "vertical_spacing_factor": 0.2,
        "filter_layout": "drawer",
        "quick_links_menu": "collection-links",
        "show_sort_by": true,
        "show_filters": true,
        "show_results_count": true,
        "show_filter_group_name": true,
        "show_filter_values_count": false,
        "open_filters_by_default": false
      }
    },
    "subnav-tabs": {
      "type": "page-subnav",
      "settings": {
        "menu": "site-menu",
        "style": "tabs"
      }
    }
  },
  "order": [
    "collection-banner",
    "subnav-tabs",
    "main"
  ]
}
