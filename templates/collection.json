{
  "sections": {
    "collection-banner": {
      "type": "collection-banner",
      "settings": {
        "color_scheme": "scheme-4",
        "image": "{{ collection.image }}",
        "mobile_image": "{{ collection.image }}",
        "image_size": "sm",
        "allow_transparent_header": false,
        "show_image": true,
        "reveal": true,
        "enable_parallax": true,
        "show_collection_title": true,
        "show_collection_description": true,
        "show_breadcrumb": false,
        "content_width": "xs",
        "overlay_color": "#000000",
        "overlay_opacity": 50,
        "plain_color_scheme": "scheme-1",
        "all_products_title": "All rugs"
      }
    },
    "main": {
      "type": "rug-list",
      "blocks": {
        "filter-collection": {
          "type": "filter",
          "settings": {
            "source": "collection",
            "label": "",
            "note": "",
            "open": true
          }
        },
        "filter-level": {
          "type": "filter",
          "settings": {
            "source": "level",
            "label": "",
            "note": "How demanding the design is to make. It sets the price per m².",
            "open": true
          }
        },
        "filter-material": {
          "type": "filter",
          "settings": {
            "source": "material",
            "label": "",
            "note": "",
            "open": true
          }
        },
        "filter-pile": {
          "type": "filter",
          "settings": {
            "source": "pile",
            "label": "",
            "note": "",
            "open": true
          }
        },
        "filter-colour": {
          "type": "filter",
          "settings": {
            "source": "colour",
            "label": "Colour as shown",
            "note": "Every rug can be made in any colour.",
            "open": true
          }
        }
      },
      "block_order": [
        "filter-collection",
        "filter-level",
        "filter-material",
        "filter-pile",
        "filter-colour"
      ],
      "settings": {
        "color_scheme": "scheme-1",
        "products_per_row_mobile": "2",
        "products_size_desktop": "large",
        "show_card_meta": true,
        "horizontal_spacing_factor": 0.2,
        "vertical_spacing_factor": 0.2,
        "filter_layout": "sidebar",
        "min_products_for_filters": 10,
        "collection_menu": "collection-links",
        "empty_link_text": "Tailor your rug",
        "empty_link": "shopify://pages/tailor-your-rug"
      }
    },
    "subnav-tabs": {
      "type": "page-subnav",
      "settings": {
        "menu": "site-menu",
        "style": "tabs",
        "sticky": false
      }
    },
    "related_projects": {
      "type": "project-cards",
      "settings": {
        "color_scheme": "scheme-1",
        "separate_section_with_border": true,
        "subheading": "Portfolio",
        "title": "Projects with these rugs",
        "text": "",
        "source": "related",
        "limit": 3,
        "style": "caption",
        "show_designer": true,
        "button_text": "See all projects",
        "button_link": "shopify://pages/portfolio"
      }
    }
  },
  "order": [
    "collection-banner",
    "subnav-tabs",
    "main",
    "related_projects"
  ]
}
