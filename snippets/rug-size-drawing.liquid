{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
RUG SIZE DRAWING (Corvo addition)
----------------------------------------------------------------------------------------------------------------------

A room seen from above, drawn to scale (one unit is one centimetre), that shows where a rug sits under the
furniture. The lines take the colour of the text around them, so a drawing follows the colour scheme of its section.

The drawing is a picture: what it shows is said in words beside it, and in its description. A short measuring line
marks the distance that the rule beside the drawing gives in centimetres.

********************************************
Supported variables
********************************************

* kind: "living", "dining", "bedroom" or "open" (required)
* label: the description of the drawing, for readers that cannot see it (required)
{%- endcomment -%}

{%- case kind -%}
  {%- when 'dining' -%}
    <svg class="size-drawing" viewBox="0 0 480 380" role="img" aria-label="{{ label | escape }}" xmlns="http://www.w3.org/2000/svg">
      <rect class="size-drawing__wall" x="1" y="1" width="478" height="378"/>
      <rect class="size-drawing__rug" x="70" y="70" width="340" height="240"/>

      {%- comment -%}Chairs: three on each long side, one at each end{%- endcomment -%}
      <rect class="size-drawing__item" x="152" y="100" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="218" y="100" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="284" y="100" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="152" y="236" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="218" y="236" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="284" y="236" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="100" y="168" width="44" height="44" rx="5"/>
      <rect class="size-drawing__item" x="336" y="168" width="44" height="44" rx="5"/>

      {%- comment -%}Table{%- endcomment -%}
      <rect class="size-drawing__item" x="140" y="140" width="200" height="100" rx="2"/>

      {%- comment -%}From the edge of the table to the edge of the rug{%- endcomment -%}
      <path class="size-drawing__mark" d="M378 74V136M372 74H384M372 136H384"/>
    </svg>

  {%- when 'bedroom' -%}
    <svg class="size-drawing" viewBox="0 0 480 380" role="img" aria-label="{{ label | escape }}" xmlns="http://www.w3.org/2000/svg">
      <rect class="size-drawing__wall" x="1" y="1" width="478" height="378"/>
      <rect class="size-drawing__rug" x="80" y="96" width="320" height="200"/>

      {%- comment -%}Bedside tables{%- endcomment -%}
      <rect class="size-drawing__item" x="98" y="22" width="44" height="40" rx="2"/>
      <rect class="size-drawing__item" x="338" y="22" width="44" height="40" rx="2"/>

      {%- comment -%}Bed, its headboard against the wall, and two pillows{%- endcomment -%}
      <rect class="size-drawing__item" x="150" y="22" width="180" height="200" rx="3"/>
      <rect class="size-drawing__item" x="150" y="12" width="180" height="10"/>
      <rect class="size-drawing__item" x="162" y="34" width="72" height="36" rx="6"/>
      <rect class="size-drawing__item" x="246" y="34" width="72" height="36" rx="6"/>
      <path class="size-drawing__line" d="M150 96H330"/>

      {%- comment -%}From the side of the bed, and from its foot, to the edge of the rug{%- endcomment -%}
      <path class="size-drawing__mark" d="M334 190H396M334 184V196M396 184V196"/>
      <path class="size-drawing__mark" d="M240 226V292M234 226H246M234 292H246"/>
    </svg>

  {%- when 'open' -%}
    <svg class="size-drawing" viewBox="0 0 480 380" role="img" aria-label="{{ label | escape }}" xmlns="http://www.w3.org/2000/svg">
      <rect class="size-drawing__wall" x="1" y="1" width="478" height="378"/>

      {%- comment -%}Seating: a rug, a sofa, an armchair and a low table{%- endcomment -%}
      <rect class="size-drawing__rug" x="24" y="64" width="210" height="250"/>
      <rect class="size-drawing__item" x="44" y="24" width="170" height="74" rx="6"/>
      <path class="size-drawing__line" d="M44 44H214"/>
      <rect class="size-drawing__item" x="96" y="276" width="66" height="66" rx="6"/>
      <path class="size-drawing__line" d="M96 326H162"/>
      <rect class="size-drawing__item" x="84" y="150" width="90" height="56" rx="2"/>

      {%- comment -%}Dining: a second rug under the table and its chairs{%- endcomment -%}
      <rect class="size-drawing__rug" x="270" y="84" width="186" height="210"/>
      <rect class="size-drawing__item" x="308" y="116" width="36" height="36" rx="5"/>
      <rect class="size-drawing__item" x="382" y="116" width="36" height="36" rx="5"/>
      <rect class="size-drawing__item" x="308" y="226" width="36" height="36" rx="5"/>
      <rect class="size-drawing__item" x="382" y="226" width="36" height="36" rx="5"/>
      <rect class="size-drawing__item" x="298" y="146" width="130" height="86" rx="2"/>
    </svg>

  {%- else -%}
    <svg class="size-drawing" viewBox="0 0 480 380" role="img" aria-label="{{ label | escape }}" xmlns="http://www.w3.org/2000/svg">
      <rect class="size-drawing__wall" x="1" y="1" width="478" height="378"/>
      <rect class="size-drawing__rug" x="38" y="56" width="404" height="286"/>

      {%- comment -%}Sofa against the wall, its front legs on the rug{%- endcomment -%}
      <rect class="size-drawing__item" x="120" y="12" width="240" height="92" rx="6"/>
      <path class="size-drawing__line" d="M120 36H360"/>

      {%- comment -%}Two armchairs facing it, their front legs on the rug{%- endcomment -%}
      <rect class="size-drawing__item" x="96" y="290" width="80" height="78" rx="6"/>
      <path class="size-drawing__line" d="M96 350H176"/>
      <rect class="size-drawing__item" x="304" y="290" width="80" height="78" rx="6"/>
      <path class="size-drawing__line" d="M304 350H384"/>

      {%- comment -%}Low table{%- endcomment -%}
      <rect class="size-drawing__item" x="176" y="164" width="128" height="68" rx="2"/>

      {%- comment -%}Floor left visible between the rug and the wall{%- endcomment -%}
      <path class="size-drawing__mark" d="M4 200H36M4 194V206M36 194V206"/>
    </svg>
{%- endcase -%}
