{%- comment -%}
This snippet structures the micro-data using JSON-LD specification. Starting from Prestige 10, we are using
the structured_data built-in filter to ensure that Shopify can keep it up to date without requiring theme upgrade. If
you believe some information for products are missing, please reach Shopify support directly, as it is no longer
managed at the theme level.
{%- endcomment -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{- product | structured_data -}}
  </script>
{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {{- article | structured_data -}}
  </script>
{%- endif -%}

{%- comment -%}
Corvo addition: the facts of a rug as structured data. Shopify's own block above names the rug and prices its sizes;
this one adds what it is made of and how, under the same "@id", so that readers merge the two.
{%- endcomment -%}
{%- if request.page_type == 'product' and product.metafields.rug.craft_level.value != blank -%}
  {%- liquid
    assign rug_craft = product.metafields.rug.craft_level.value
    assign rug_materials = product.metafields.rug.materials.value | map: 'name' | map: 'value' | join: ', '
    assign rug_pile = product.metafields.rug.pile.value | join: ' and '
    assign rug_own_factor = product.metafields.rug.supplement.value | default: 0 | plus: 100 | divided_by: 100.0
    assign rug_vat_factor = settings.rug_vat_percent | default: 23 | plus: 100 | divided_by: 100.0
    assign rug_per_m2 = rug_craft.retail_per_m2.value | times: rug_own_factor | times: rug_vat_factor | round: 2
    assign rug_product_id = product.url | append: '#product'

    capture rug_lead_time
      render 'corvo-fact', fact: 'lead_time'
    endcapture

    capture rug_delivery
      render 'corvo-fact', fact: 'delivery'
    endcapture

    capture rug_returns
      render 'corvo-fact', fact: 'returns'
    endcapture

    assign rug_limit_text = 'rug_page.facts.limit' | t

    capture rug_limit
      render 'corvo-fill', text: rug_limit_text
    endcapture
  -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@id": {{ rug_product_id | json }},
      "@type": "ProductGroup",
      "manufacturer": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
      "countryOfOrigin": { "@type": "Country", "name": "Portugal" },
      {%- if rug_materials != blank -%}
        "material": {{ rug_materials | json }},
      {%- endif -%}
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Craft level", "value": {{ rug_craft.label.value | json }} }
        {%- if rug_pile != blank -%}
          ,{ "@type": "PropertyValue", "name": "Pile", "value": {{ rug_pile | json }} }
        {%- endif -%}
        {%- if product.metafields.rug.pile_height.value != blank -%}
          ,{ "@type": "PropertyValue", "name": "Pile height", "value": {{ product.metafields.rug.pile_height.value | json }} }
        {%- endif -%}
        {%- if product.metafields.rug.colours.value != blank -%}
          ,{ "@type": "PropertyValue", "name": "Number of colours", "value": {{ product.metafields.rug.colours.value | json }} }
        {%- endif -%}
        {%- if product.metafields.rug.colour_family.value != blank -%}
          ,{ "@type": "PropertyValue", "name": "Colour family", "value": {{ product.metafields.rug.colour_family.value | join: ', ' | json }} }
        {%- endif -%}
        ,{ "@type": "PropertyValue", "name": "Made to order", "value": "Yes, hand-tufted in Portugal" }
        ,{ "@type": "PropertyValue", "name": "Lead time", "value": {{ rug_lead_time | strip | json }} }
        ,{ "@type": "PropertyValue", "name": "Delivery", "value": {{ rug_delivery | strip | json }} }
        ,{ "@type": "PropertyValue", "name": "Returns", "value": {{ rug_returns | strip | json }} }
        ,{ "@type": "PropertyValue", "name": "Made to measure", "value": {{ rug_limit | strip | json }} }
        ,{ "@type": "PropertyValue", "name": "Made-to-measure price per square metre, VAT included", "value": {{ rug_per_m2 | json }}, "unitText": {{ shop.currency | json }} }
      ]
    }
  </script>
{%- endif -%}

{%- comment -%}Corvo addition: the rugs of a collection page, as a list{%- endcomment -%}
{%- if request.page_type == 'collection' and collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ItemList",
      "name": {{ collection.title | json }},
      "numberOfItems": {{ collection.products_count }},
      "itemListElement": [
        {%- for list_product in collection.products limit: 50 -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "name": {{ list_product.title | json }},
            "url": {{ shop.url | append: list_product.url | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- comment -%}
Corvo addition: the bespoke service, on the pages that present it. The price per m² of each craft level is read from
the "Craft level" entries, with the VAT of the theme settings.
{%- endcomment -%}
{%- if request.page_type == 'page' -%}
  {%- assign service_handles = 'bespoke|bespoke-service|tailor-your-rug' | split: '|' -%}

  {%- if service_handles contains page.handle -%}
    {%- liquid
      assign service_vat_plus = settings.rug_vat_percent | default: 23 | plus: 100

      capture service_description
        render 'corvo-fill', text: 'Corvo designs and makes rugs to order: any design, in any size up to [max_size], in [materials_count] materials and in any colour. Each rug is hand-tufted in Portugal in [lead_weeks] weeks and delivered worldwide.'
      endcapture
    -%}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "@id": {{ shop.url | append: '/pages/bespoke#service' | json }},
        "name": "Bespoke rugs",
        "serviceType": "Bespoke rug design and making",
        "description": {{ service_description | strip | json }},
        "url": {{ shop.url | append: '/pages/bespoke' | json }},
        "provider": { "@type": "Organization", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} },
        "areaServed": "Worldwide",
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Price per square metre by craft level, VAT included",
          "itemListElement": [
            {%- for service_level in shop.metaobjects.craft_level.values -%}
              {
                "@type": "Offer",
                "name": {{ 'Craft level ' | append: service_level.label.value | json }},
                "description": {{ service_level.description.value | json }},
                "priceSpecification": {
                  "@type": "UnitPriceSpecification",
                  "price": {{ service_level.retail_per_m2.value | times: service_vat_plus | divided_by: 100.0 | round: 2 | json }},
                  "priceCurrency": {{ shop.currency | json }},
                  "valueAddedTaxIncluded": true,
                  "unitCode": "MTK",
                  "unitText": "m²"
                }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      }
    </script>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
Corvo addition: a page that belongs to a group of the site menu (Bespoke, Resources, About) names that group in its
breadcrumb.
{%- endcomment -%}
{%- liquid
  assign crumb_parent = nil

  if request.page_type == 'page'
    for crumb_link in linklists['site-menu'].links
      for crumb_child in crumb_link.links
        if crumb_child.url == page.url and crumb_link.url != page.url
          assign crumb_parent = crumb_link
        endif
      endfor
    endfor
  endif
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.home' | t | json }},
        "item": "{{ shop.url }}"
      }

      {%- if request.page_type == 'product' -%}
        {%- if collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {%- endif -%}
      {%- elsif request.page_type == 'collection' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection.url }}"
          }
      {%- elsif request.page_type == 'blog' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }
      {%- elsif request.page_type == 'article' -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ article.url }}"
          }
      {%- elsif request.page_type == 'metaobject' and metaobject.system.type == 'project' -%}
        {%- comment -%}Corvo addition: a project belongs to the Portfolio{%- endcomment -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ pages['portfolio'].title | default: 'Portfolio' | json }},
            "item": "{{ shop.url }}{{ pages['portfolio'].url | default: '/pages/portfolio' }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ metaobject.title.value | json }},
            "item": "{{ shop.url }}{{ metaobject.system.url }}"
          }
      {%- elsif request.page_type == 'page' and crumb_parent != nil -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ crumb_parent.title | json }},
            "item": "{{ shop.url }}{{ crumb_parent.url }}"
          }, {
            "@type": "ListItem",
            "position": 3,
            "name": {{ page.title | json }},
            "item": "{{ shop.url }}{{ page.url }}"
          }
      {%- elsif request.page_type == 'page' -%}
        ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ page.title | json }},
            "item": "{{ shop.url }}{{ page.url }}"
          }
      {%- endif -%}
    ]
  }
</script>

{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" -%}

  <script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | append: page.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      {%- comment -%}Corvo addition: who Corvo is, where, and whose company it is{%- endcomment -%}
      "alternateName": "Corvo Rugs",
      {%- unless shop.brand.short_description -%}
        {%- capture corvo_description -%}{%- render 'corvo-fact', fact: 'description' -%}{%- endcapture -%}
        "description": {{ corvo_description | strip | json }},
      {%- endunless -%}
      "address": { "@type": "PostalAddress", "addressLocality": {{ 'general.corvo.locality' | t | json }}, "addressCountry": "PT" },
      "parentOrganization": { "@type": "Organization", "name": {{ 'general.corvo.parent' | t | json }} },
      "knowsAbout": ["Bespoke rugs", "Made-to-measure rugs", "Hand-tufted rugs"],
      {%- unless shop.brand.logo -%}
        "logo": {{ 'CorvoPreto.png' | file_url | prepend: 'https:' | json }},
      {%- endunless -%}
      {%- unless shop.brand.slogan -%}
        "slogan": {{ 'general.corvo.slogan' | t | json }},
      {%- endunless -%}
      {%- unless shop.brand.metafields.social_links.size > 0 -%}
        {%- if settings.social_instagram != blank -%}
          "sameAs": [{{ settings.social_instagram | json }}],
        {%- endif -%}
      {%- endunless -%}
      {%- if shop.brand.logo -%}
        "logo": {{ shop.brand.logo | image_url: width: shop.brand.logo.width | prepend: "https:" | json }},
      {%- endif -%}
      {%- if shop.brand.short_description -%}
        "description": {{ shop.brand.short_description | json }},
      {%- endif -%}
      {%- if shop.brand.slogan -%}
        "slogan": {{ shop.brand.slogan | json }},
      {%- endif -%}
      {%- if shop.brand.metafields.social_links.size > 0 -%}
        "sameAs": [
          {%- for social_link in shop.brand.metafields.social_links -%}
            {{- social_link.last.value | json -}}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ],
      {%- endif -%}
      "url": {{ shop.url | append: page.url | json }}
    }
  ]
  </script>
{%- endif -%}